#!/usr/bin/env bash
# Helper backend para Proyector & Duplicación de Pantalla (Epson / Miracast / Smart TVs)
# Soporta auto-detección de monitor nativo, múltiples aspect ratios (16:9, 16:10, 21:9, 32:9, 4:3),
# diagnóstico no privilegiado y control seguro de procesos.

set -eo pipefail

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-projector"
mkdir -p "$STATE_DIR"

check_firewall() {
  local ufw_active="false"
  local firewall_ok="true"

  if command -v systemctl >/dev/null 2>&1 && systemctl is-active --quiet ufw 2>/dev/null; then
    ufw_active="true"
    # Revisar si la regla para 7236 está en /etc/ufw/user.rules o mediante consulta no interactiva
    if [ -r /etc/ufw/user.rules ] && grep -qE "7236" /etc/ufw/user.rules 2>/dev/null; then
      firewall_ok="true"
    elif sudo -n ufw status 2>/dev/null | grep -qE "7236"; then
      firewall_ok="true"
    else
      firewall_ok="false"
    fi
  fi

  printf '{"ufwActive":%s,"firewallOk":%s}' "$ufw_active" "$firewall_ok"
}

get_primary_monitor_info() {
  local monitors_json
  monitors_json=$(hyprctl monitors -j 2>/dev/null || echo "[]")

  # Preferir monitor con foco o el primero disponible
  local mon_info
  mon_info=$(echo "$monitors_json" | jq -c '(.[] | select(.focused == true)) // .[0] // {}' 2>/dev/null || echo "{}")

  echo "$mon_info"
}

cmd_status() {
  local gnd_installed="false"
  if command -v gnome-network-displays >/dev/null 2>&1; then
    gnd_installed="true"
  fi

  local gnd_running="false"
  if pgrep -x "gnome-network-displays" >/dev/null 2>&1 || pgrep -x "gnome-network-d" >/dev/null 2>&1; then
    gnd_running="true"
  fi

  # Lista de todos los monitores activos
  local raw_monitors
  raw_monitors=$(hyprctl monitors -j 2>/dev/null || echo "[]")
  local monitors_list
  monitors_list=$(echo "$raw_monitors" | jq -c '[.[] | {name: .name, width: .width, height: .height, scale: .scale, focused: .focused}]' 2>/dev/null || echo "[]")

  local mon_info
  mon_info=$(get_primary_monitor_info)

  local primary_name="eDP-1"
  local cur_res="1920x1080@60"
  local cur_scale="1"

  if [ -n "$mon_info" ] && [ "$mon_info" != "{}" ]; then
    primary_name=$(echo "$mon_info" | jq -r '.name // "eDP-1"')
    local w h r s
    w=$(echo "$mon_info" | jq -r '.width // 1920')
    h=$(echo "$mon_info" | jq -r '.height // 1080')
    r=$(echo "$mon_info" | jq -r '.refreshRate // 60' | cut -d. -f1)
    s=$(echo "$mon_info" | jq -r '.scale // 1')
    cur_res="${w}x${h}@${r}"
    cur_scale="$s"
  fi

  # Guardar o leer resolución nativa de fábrica de este monitor
  local native_file="$STATE_DIR/native_${primary_name}.json"
  local native_res="$cur_res"
  local native_scale="$cur_scale"

  if [ -f "$native_file" ]; then
    native_res=$(jq -r '.resolution // "1920x1080@60"' "$native_file" 2>/dev/null || echo "$cur_res")
    native_scale=$(jq -r '.scale // "1"' "$native_file" 2>/dev/null || echo "$cur_scale")
  else
    local best_mode
    best_mode=$(echo "$mon_info" | jq -r '.availableModes[0] // empty' 2>/dev/null || true)
    if [ -n "$best_mode" ]; then
      native_res=$(echo "$best_mode" | sed -E "s/@([0-9]+)(\\.[0-9]+)?Hz/@\1/" | sed "s/Hz//")
    fi
    printf '{"resolution":"%s","scale":"%s"}\n' "$native_res" "$native_scale" > "$native_file"
  fi

  # Wi-Fi Direct / P2P
  local p2p_supported="false"
  local p2p_interface="wlp1s0"
  if command -v iw >/dev/null 2>&1 && iw dev 2>/dev/null | grep -qi "P2P-device"; then
    p2p_supported="true"
  elif ip link show 2>/dev/null | grep -qiE "p2p-|wlan|wlp"; then
    p2p_supported="true"
  fi

  # Detección de banda Wi-Fi activa (5 GHz vs 2.4 GHz)
  local wifi_band="Unknown"
  if command -v nmcli >/dev/null 2>&1; then
    local freq_nm
    freq_nm=$(nmcli -t -f active,freq dev wifi 2>/dev/null | grep '^yes:' | cut -d: -f2 | grep -oE '[0-9]+' | head -n 1 || true)
    if [ -n "$freq_nm" ]; then
      if [ "$freq_nm" -gt 4000 ]; then
        wifi_band="5GHz"
      else
        wifi_band="2.4GHz"
      fi
    fi
  fi
  if [ "$wifi_band" = "Unknown" ] && command -v iw >/dev/null 2>&1; then
    local freq_iw
    freq_iw=$(iw dev 2>/dev/null | grep -iE "channel" | grep -oE "\([0-9]+ MHz\)" | tr -dc '0-9' | head -n 1 || true)
    if [ -n "$freq_iw" ]; then
      if [ "$freq_iw" -gt 4000 ]; then
        wifi_band="5GHz"
      else
        wifi_band="2.4GHz"
      fi
    fi
  fi

  # Estado del portal ScreenCast
  local portal_ok="false"
  if command -v systemctl >/dev/null 2>&1; then
    if systemctl --user is-active --quiet xdg-desktop-portal-hyprland 2>/dev/null; then
      portal_ok="true"
    elif [ -x /usr/lib/xdg-desktop-portal-hyprland ] || [ -f /usr/lib/systemd/user/xdg-desktop-portal-hyprland.service ]; then
      systemctl --user start xdg-desktop-portal-hyprland 2>/dev/null || true
      if systemctl --user is-active --quiet xdg-desktop-portal-hyprland 2>/dev/null; then
        portal_ok="true"
      fi
    fi
  fi

  # Estado del Modo Presentación (anti-suspensión)
  local pres_mode="false"
  local pres_pid_file="$STATE_DIR/presentation.pid"
  if [ -f "$pres_pid_file" ]; then
    local pid
    pid=$(cat "$pres_pid_file" 2>/dev/null || true)
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
      pres_mode="true"
    else
      rm -f "$pres_pid_file"
    fi
  fi

  local fw_json
  fw_json=$(check_firewall)

  printf '{"gndInstalled":%s,"gndRunning":%s,"primaryMonitor":"%s","currentResolution":"%s","currentScale":"%s","nativeResolution":"%s","nativeScale":"%s","p2pSupported":%s,"p2pInterface":"%s","wifiBand":"%s","portalOk":%s,"presentationMode":%s,"monitors":%s,"firewall":%s}\n' \
    "$gnd_installed" "$gnd_running" "$primary_name" "$cur_res" "$cur_scale" "$native_res" "$native_scale" "$p2p_supported" "$p2p_interface" "$wifi_band" "$portal_ok" "$pres_mode" "$monitors_list" "$fw_json"
}

cmd_set_res() {
  local mode="${1:-1920x1080@60}"
  local scale="${2:-1}"
  local target_mon="${3:-}"

  # Strict input validation: mode must only be WxH or WxH@R (digits, 'x', '@', '.')
  if [[ ! "$mode" =~ ^[0-9]{3,5}x[0-9]{3,5}(@[0-9]{1,3}(\.[0-9]+)?)?$ ]]; then
    echo "Error: Invalid resolution format '$mode'" >&2
    return 1
  fi

  if [[ ! "$mode" =~ @ ]]; then
    mode="${mode}@60"
  fi

  # Strict input validation: scale must be a positive decimal or integer
  if [[ ! "$scale" =~ ^[0-9]+(\.[0-9]{1,2})?$ ]]; then
    scale="1"
  fi

  # Auto escala inteligente para pantallas de alta densidad si no se especificó escala
  if [ "$scale" = "1" ] || [ -z "$scale" ]; then
    if [[ "$mode" =~ 3840x2160 ]] || [[ "$mode" =~ 5120x2880 ]]; then
      scale="2"
    elif [[ "$mode" =~ 3200x2000 ]]; then
      scale="1.6"
    elif [[ "$mode" =~ 2880x1800 ]] || [[ "$mode" =~ 3000x2000 ]]; then
      scale="1.5"
    elif [[ "$mode" =~ 2560x1440 ]] || [[ "$mode" =~ 2560x1600 ]] || [[ "$mode" =~ 3440x1440 ]] || [[ "$mode" =~ 5120x1440 ]]; then
      scale="1.25"
    fi
  fi

  local mon_name="$target_mon"
  if [ -z "$mon_name" ]; then
    local mon_info
    mon_info=$(get_primary_monitor_info)
    mon_name=$(echo "$mon_info" | jq -r '.name // "eDP-1"' 2>/dev/null || echo "eDP-1")
  fi

  # Strict validation: monitor name must only be alphanumeric, '-' and '_'
  if [[ ! "$mon_name" =~ ^[a-zA-Z0-9_\-]+$ ]]; then
    mon_name="eDP-1"
  fi

  # Execute via Lua engine (required by Omarchy Hyprland with Lua configs)
  if ! hyprctl eval "hl.monitor({ output = \"$mon_name\", mode = \"$mode\", position = \"0x0\", scale = $scale, transform = 0 })" >/dev/null 2>&1; then
    # Fallback for legacy parsers
    hyprctl keyword monitor "$mon_name,$mode,auto,$scale" >/dev/null 2>&1 || true
  fi

  echo "res_set:$mode:$scale:$mon_name"
}

cmd_reset_res() {
  local target_mon="${1:-}"
  local mon_name="$target_mon"
  if [ -z "$mon_name" ]; then
    local mon_info
    mon_info=$(get_primary_monitor_info)
    mon_name=$(echo "$mon_info" | jq -r '.name // "eDP-1"' 2>/dev/null || echo "eDP-1")
  fi

  # Strict validation: monitor name must only be alphanumeric, '-' and '_'
  if [[ ! "$mon_name" =~ ^[a-zA-Z0-9_\-]+$ ]]; then
    mon_name="eDP-1"
  fi

  local native_file="$STATE_DIR/native_${mon_name}.json"
  local target_res="1920x1080@60"
  local target_scale="1"

  if [ -f "$native_file" ]; then
    target_res=$(jq -r '.resolution // "1920x1080@60"' "$native_file" 2>/dev/null || echo "1920x1080@60")
    target_scale=$(jq -r '.scale // "1"' "$native_file" 2>/dev/null || echo "1")
  fi

  cmd_set_res "$target_res" "$target_scale" "$mon_name"
}

cmd_toggle_presentation_mode() {
  local pres_pid_file="$STATE_DIR/presentation.pid"
  if [ -f "$pres_pid_file" ] && kill -0 "$(cat "$pres_pid_file" 2>/dev/null)" 2>/dev/null; then
    local pid
    pid=$(cat "$pres_pid_file" 2>/dev/null)
    kill "$pid" 2>/dev/null || true
    rm -f "$pres_pid_file"
    # Restaurar notificaciones
    if command -v makoctl >/dev/null 2>&1; then
      makoctl mode -r do-not-disturb 2>/dev/null || true
    fi
    if command -v dunstctl >/dev/null 2>&1; then
      dunstctl set-paused false 2>/dev/null || true
    fi
    if command -v notify-send >/dev/null 2>&1; then
      notify-send -t 2000 "Projector & Cast" "Presentation Mode: Disabled (Notifications & Sleep Restored)"
    fi
    echo "presentation:disabled"
  else
    if command -v systemd-inhibit >/dev/null 2>&1; then
      nohup systemd-inhibit --what=idle:sleep --who="Projector & Cast" --why="Presentation in progress" sleep infinity >/dev/null 2>&1 &
      echo $! > "$pres_pid_file"
    else
      nohup sh -c 'while true; do sleep 30; done' >/dev/null 2>&1 &
      echo $! > "$pres_pid_file"
    fi
    # Silenciar notificaciones (DND)
    if command -v makoctl >/dev/null 2>&1; then
      makoctl mode -a do-not-disturb 2>/dev/null || true
    fi
    if command -v dunstctl >/dev/null 2>&1; then
      dunstctl set-paused true 2>/dev/null || true
    fi
    if command -v notify-send >/dev/null 2>&1; then
      notify-send -t 2500 "Projector & Cast" "Presentation Mode: Active (Sleep Inhibited & Notifications Muted)"
    fi
    echo "presentation:enabled"
  fi
}

cmd_launch() {
  if ! command -v gnome-network-displays >/dev/null 2>&1; then
    if command -v notify-send >/dev/null 2>&1; then
      notify-send -u critical "Projector & Cast" "GNOME Network Displays is not installed."
    fi
    echo "not_installed"
    return 1
  fi

  # Asegurar que el portal ScreenCast de Hyprland esté activo para captura de pantalla
  if command -v systemctl >/dev/null 2>&1; then
    if ! systemctl --user is-active --quiet xdg-desktop-portal-hyprland 2>/dev/null; then
      systemctl --user start xdg-desktop-portal-hyprland 2>/dev/null || true
    fi
  fi

  # Coincidencia estricta por nombre exacto de proceso
  if pgrep -x "gnome-network-displays" >/dev/null 2>&1 || pgrep -x "gnome-network-d" >/dev/null 2>&1; then
    hyprctl dispatch focuswindow "class:gnome-network-displays" >/dev/null 2>&1 || true
  else
    nohup gnome-network-displays >/dev/null 2>&1 &
  fi
  echo "launched"
}

cmd_stop() {
  # Terminar únicamente el binario exacto de gnome-network-displays de manera segura
  local stopped="false"
  if pgrep -x "gnome-network-displays" >/dev/null 2>&1; then
    pkill -x "gnome-network-displays" 2>/dev/null || true
    stopped="true"
  fi
  if pgrep -x "gnome-network-d" >/dev/null 2>&1; then
    pkill -x "gnome-network-d" 2>/dev/null || true
    stopped="true"
  fi
  echo "stopped"
}

cmd_copy_firewall_cmd() {
  local cmd="sudo ufw allow 7236/tcp comment 'Miracast-RTSP'"
  if command -v wl-copy >/dev/null 2>&1; then
    printf "%s" "$cmd" | wl-copy
  fi
  if command -v notify-send >/dev/null 2>&1; then
    notify-send "Projector & Cast" "Firewall command copied to clipboard:\n$cmd"
  fi
  echo "copied"
}

case "${1:-}" in
  status)
    cmd_status
    ;;
  set-res)
    shift
    cmd_set_res "$@"
    ;;
  reset-res)
    shift
    cmd_reset_res "$@"
    ;;
  toggle-presentation-mode)
    cmd_toggle_presentation_mode
    ;;
  launch)
    cmd_launch
    ;;
  stop)
    cmd_stop
    ;;
  copy-firewall-cmd)
    cmd_copy_firewall_cmd
    ;;
  *)
    echo "Usage: $0 {status|set-res <mode> [scale] [mon]|reset-res [mon]|toggle-presentation-mode|launch|stop|copy-firewall-cmd}"
    exit 1
    ;;
esac
